<mvc:View controllerName="app.splitapp.controller.DetailView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    	xmlns:f="sap.ui.layout.form">
   			<Page id="idDetail" title="Detail View" showNavButton="true" navButtonPress="onListView">
		<content>
			<f:SimpleForm editable="true" id="idSimple">
				<Label text="Tool Name" class="bold-class"></Label>
				<Input id='idinput1' value="{toolsModel>toolsName}"></Input>
				<Label text="Uses"></Label>
				<Input id='idinput2' value="{toolsModel>uses}"></Input>
				<Label text="Availability"></Label>
				<Input id='idinput3' value="{toolsModel>availability}"></Input>
				<Label text="Price"></Label>
				<Input id='idinput4' value="{toolsModel>price}"></Input>
				<Label text="Unit"></Label>
				<Input id='idinput5' value="{toolsModel>unit}"></Input>
				<Label text="Image"></Label>
				<Image id='idinput6' src="{toolsModel>image}" width="200px"></Image>
				<Label text="Weight"></Label>
				<Input id='idinput7' value="{toolsModel>weight}"></Input>
				<Label text="Warranty"></Label>
				<Input id='idinput8' value="{toolsModel>warranty}"></Input>
			</f:SimpleForm>
			            <IconTabBar>
                <items>
                    <IconTabFilter icon="sap-icon://information">
                        <VBox>
                            <HBox >
                                <Label text="Toolsname" class="bold-class" design="Bold"></Label>
                                <Input id='idinput11' value="{path:'toolsModel>toolsName',formatter:'.someVariable.upperCase'}"></Input>
                            </HBox>
                            <HBox >
                                <Label text="Uses"></Label>
                                <Input id='idinput22' value="{toolsModel>uses}"></Input>
                            </HBox>
                            <HBox >
                                <Label text="availability"></Label>
                                <Input id='idinput33' value="{toolsModel>availability}"></Input>
                            </HBox>
                        </VBox>
                    </IconTabFilter>
 
                    <IconTabFilter icon="sap-icon://supplier">
                        <Table items="{toolsModel>/supplierSet}">
                            <columns>
                                <Column >
                                    <Text text="toolsName"></Text>
                                </Column>
                                <Column >
                                    <Text text="supplierName"></Text>
                                </Column>
                                <Column >
                                    <Text text="contact"></Text>
                                </Column>
                                <Column >
                                    <Text text="location"></Text>
                                </Column>
                            </columns>
                            <ColumnListItem >
                                <cells>
                                    <Text text="{toolsModel>toolsName}"></Text>
                                    <Text text="{toolsModel>supplierName}"></Text>
                                    <Text text="{toolsModel>contact}"></Text>
                                    <Text text="{toolsModel>location}"></Text>
                                </cells>
                            </ColumnListItem>
                        </Table>
                    </IconTabFilter>
                </items>
            </IconTabBar>
 
		</content>
	</Page>
</mvc:View>